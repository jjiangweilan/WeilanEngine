import WeilanEngine;
import Library.PerScene;
import SceneLit; // use it's Vertex function
import Lighting; // use it's lighting function

[shader("vertex")]
VertexOutput VertexMain(VertexInput input)
{
    return SceneLitVertex(input);
}

[shader("vertex")]
VertexOutput VertexMain(VertexInput input)
{
    return SceneLitVertex(input);
}
